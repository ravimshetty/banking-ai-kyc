# Copy this file to .env and edit. Real environment variables override these values.

# PostgreSQL connection: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Default (unset) = postgresql://bank:bank@localhost:5432/banking_ai, which matches docker-compose.yml.
# Only uncomment to point somewhere else (e.g. port 5433). Leave it commented when running inside Docker.
# DATABASE_URL=postgresql://bank:bank@localhost:5432/banking_ai

# Optional OpenAI. Leave the key empty to run fully offline (deterministic routing and answers).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# 1 = force offline mode even when a key is present (the tests do this)
BANKING_AI_OFFLINE=0
