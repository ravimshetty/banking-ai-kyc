{
  // VS Code "Dev Containers: Reopen in Container": VS Code runs inside the Linux app container, so the
  // Test Explorer, debugger and terminal all work without Python on Windows (and without Smart App Control).
  "name": "Banking AI",
  "dockerComposeFile": ["../docker-compose.yml"],
  "service": "app",
  "runServices": ["postgres", "app"],
  "workspaceFolder": "/app",
  "shutdownAction": "stopCompose",
  "forwardPorts": [8000],
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.debugpy", "humao.rest-client"],
      "settings": { "python.defaultInterpreterPath": "/usr/local/bin/python" }
    }
  }
}
